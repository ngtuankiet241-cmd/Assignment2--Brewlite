# ==========================================
# BREWLITE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Sao chép tệp này thành .env và điền các giá trị thực tế trước khi chạy.
# TUYỆT ĐỐI KHÔNG commit tệp .env thật chứa secret lên GitHub!

# Backend API Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brewlite?schema=public"

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# SePay Sandbox Payment Simulation
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=SP-TEST-SAMPLE
SEPAY_SECRET_KEY=spsk_test_sample_secret_key
SEPAY_IPN_SECRET_KEY=your_ipn_secret_key
