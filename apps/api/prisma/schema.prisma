generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  REQUESTED
  PENDING
  SUCCEEDED
  FAILED
  REJECTED
}

enum PaymentMethod {
  SEPAY_QR
  CASH
}

enum StockReservationStatus {
  HELD
  CONSUMED
  RELEASED
}

enum LoyaltyType {
  EARN
  REDEEM
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model DrinkSizeOption {
  id              String   @id
  label           String
  priceAdjustment Int
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ToppingOption {
  id        String   @id
  name      String   @unique
  unitPrice Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  fullName            String
  phone               String?
  role                Role                 @default(CUSTOMER)
  loyaltyPoints       Int                  @default(0)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Int
  imageUrl    String
  stock       Int
  version     Int         @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
}


model Order {
  id                   String                  @id @default(cuid())
  userId               String?
  user                 User?                   @relation(fields: [userId], references: [id])
  customerName         String
  customerPhone        String
  tableNumber          Int?
  notes                String?

  // Quáº£n lÃ½ giÃ¡ vÃ  khuyáº¿n mÃ£i
  subtotalAmount       Int                     @default(0)
  discountAmount       Int                     @default(0)
  totalAmount          Int

  // Tráº¡ng thÃ¡i Ä‘Æ¡n hÃ ng vÃ  giá»¯ tá»“n kho
  status               OrderStatus             @default(PENDING)
  reservationStatus    StockReservationStatus?
  reservationExpiresAt DateTime?

  // Sáº£n pháº©m vÃ  thanh toÃ¡n
  items                OrderItem[]
  payment              Payment?

  // Khuyáº¿n mÃ£i
  promotionId          String?
  promotionCode        String?
  promotion            Promotion?              @relation(fields: [promotionId], references: [id])

  // Äiá»ƒm thÆ°á»Ÿng
  loyaltyTransactions  LoyaltyTransaction[]

  // HoÃ n tiá»n
  refunds              Refund[]

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([reservationStatus, reservationExpiresAt])
}


model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unitPrice   Int
  quantity    Int
  size        String  @default("M")
  toppings    String?
  itemTotal   Int
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Int
  method         PaymentMethod @default(SEPAY_QR)
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  idempotencyKey String?       @unique
  qrUrl          String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  refunds Refund[]
}

model IdempotencyRecord {
  scope       String
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  @@id([scope, key])
}

model Promotion {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Int
  minOrderValue Int          @default(0)
  maxDiscount   Int?
  validFrom     DateTime     @default(now())
  validTo       DateTime?
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model LoyaltyTransaction {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  points      Int
  type        LoyaltyType @default(EARN)
  description String?
  createdAt   DateTime    @default(now())
}



model Refund {
  id                 String       @id @default(cuid())

  // Li├¬n kß║┐t vß╗¢i ─æ╞ín h├áng
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id])

  // Li├¬n kß║┐t vß╗¢i giao dß╗ïch thanh to├ín gß╗æc
  paymentId          String
  payment            Payment      @relation(fields: [paymentId], references: [id])

  // Th├┤ng tin ho├án tiß╗ün
  amount             Int
  status             RefundStatus @default(REQUESTED)

  // Chß╗æng tß║ío y├¬u cß║ºu ho├án tiß╗ün tr├╣ng
  idempotencyKey     String       @unique

  // Th├┤ng tin giao dß╗ïch SePay ban ─æß║ºu
  originalTxnRef     String
  sepayRefundId      String?      @unique

  // Nh├ón vi├¬n x├⌐t duyß╗çt y├¬u cß║ºu
  approvedBy         String?
  approvedAt         DateTime?

  // Th├┤ng tin chuyß╗ân khoß║ún ho├án tiß╗ün thß╗º c├┤ng
  bankTransactionRef String?      @unique
  evidenceUrl        String?
  transferRecordedBy String?
  transferRecordedAt DateTime?

  // Quß║ún l├╜ x├íc minh ho├án tiß╗ün thß║¡t
  verifiedBy         String?
  verifiedAt         DateTime?

  // Th├┤ng tin tß╗½ chß╗æi hoß║╖c lß╗ùi
  rejectionReason    String?
  errorMessage       String?

  // Ho├án tiß╗ün m├┤ phß╗Ång Sandbox
  // Kh├┤ng ph├ít sinh chuyß╗ân khoß║ún ng├ón h├áng hoß║╖c ho├án tiß╗ün SePay thß║¡t
  demoReference      String?      @unique
  demoCompletedAt    DateTime?
  demoBy             String?

  // Thß╗¥i gian
  requestedAt        DateTime     @default(now())
  completedAt        DateTime?
  updatedAt          DateTime     @updatedAt

  // Index
  @@index([orderId])
  @@index([paymentId])
}
