generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  REQUESTED
  PENDING
  SUCCEEDED
  FAILED
  REJECTED
}

enum PaymentMethod {
  SEPAY_QR
  CASH
}

enum LoyaltyType {
  EARN
  REDEEM
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  fullName            String
  phone               String?
  role                Role                 @default(CUSTOMER)
  loyaltyPoints       Int                  @default(0)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Int
  imageUrl    String
  stock       Int
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
}

model Order {
  id                  String               @id @default(cuid())
  userId              String?
  user                User?                @relation(fields: [userId], references: [id])
  customerName        String
  customerPhone       String
  tableNumber         Int?
  notes               String?
  totalAmount         Int
  status              OrderStatus          @default(PENDING)
  items               OrderItem[]
  payment             Payment?
  promotionId         String?
  promotion           Promotion?           @relation(fields: [promotionId], references: [id])
  loyaltyTransactions LoyaltyTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refunds Refund[]
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productName         String
  unitPrice           Int
  quantity            Int
  size                String   @default("M")
  toppings            String?
  itemTotal           Int
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Int
  method         PaymentMethod @default(SEPAY_QR)
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  idempotencyKey String?       @unique
  qrUrl          String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  refunds Refund[]
}

model Promotion {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Int
  minOrderValue Int          @default(0)
  maxDiscount   Int?
  validFrom     DateTime     @default(now())
  validTo       DateTime?
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model LoyaltyTransaction {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  points      Int
  type        LoyaltyType @default(EARN)
  description String?
  createdAt   DateTime    @default(now())
}


model Refund {
  id                 String       @id @default(cuid())

  // Liên kết với đơn hàng
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id])

  // Liên kết với giao dịch thanh toán gốc
  paymentId          String
  payment            Payment      @relation(fields: [paymentId], references: [id])

  // Thông tin hoàn tiền
  amount             Int
  status             RefundStatus @default(REQUESTED)

  // Chống tạo yêu cầu hoàn tiền trùng
  idempotencyKey     String       @unique

  // Thông tin giao dịch SePay ban đầu
  originalTxnRef     String
  sepayRefundId      String?      @unique

  // Nhân viên xét duyệt yêu cầu
  approvedBy         String?
  approvedAt         DateTime?

  // Thông tin chuyển khoản hoàn tiền thủ công
  bankTransactionRef String?      @unique
  evidenceUrl        String?
  transferRecordedBy String?
  transferRecordedAt DateTime?

  // Quản lý xác minh hoàn tiền thật
  verifiedBy         String?
  verifiedAt         DateTime?

  // Thông tin từ chối hoặc lỗi
  rejectionReason    String?
  errorMessage       String?

  // Hoàn tiền mô phỏng Sandbox
  // Không phát sinh chuyển khoản ngân hàng hoặc hoàn tiền SePay thật
  demoReference      String?      @unique
  demoCompletedAt    DateTime?
  demoBy             String?

  // Thời gian
  requestedAt        DateTime     @default(now())
  completedAt        DateTime?
  updatedAt          DateTime     @updatedAt

  // Index
  @@index([orderId])
  @@index([paymentId])
}
